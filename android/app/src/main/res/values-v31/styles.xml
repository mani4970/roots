<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always shows a system splash before the WebView is ready.
      Match that native starting surface to Roots' light loading background
      while keeping the system-provided Roots app icon behavior unchanged.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#FAF6F0</item>
        <item name="windowSplashScreenBackground">#FAF6F0</item>
    </style>
</resources>
